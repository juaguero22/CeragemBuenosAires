@model List<CeragemBuenosAires.Models.Producto>

@{
    ViewData["Title"] = "Nuestros productos";

    var doterra = Model
        .Where(p => p.Marca == "doTERRA")
        .ToList();

    var lebelage = Model
        .Where(p => p.Marca == "LEBELAGE")
        .ToList();
}

<section class="container py-5">

    <h1 class="text-center fw-bold mb-3">
        Nuestros productos
    </h1>

    <p class="text-center text-muted mb-5">
        Descubre nuestra selección de productos para el cuidado
        personal, la belleza y el bienestar.
    </p>

    <!-- DOTERRA -->
    @if (doterra.Any())
    {
        <section class="mb-5">

            <div class="text-center mb-4">

                <img src="~/images/Productos/doterra-imagen-principal.jfif"
                     alt="Productos doTERRA"
                     class="img-fluid rounded-4 shadow-sm mb-4"
                     style="width:100%; max-height:300px; object-fit:cover;" />

                <h2 class="fw-bold text-danger">
                    doTERRA
                </h2>

                <p class="text-muted mx-auto" style="max-width:750px;">
                    Conoce nuestra selección de aceites esenciales
                    doTERRA, con diferentes aromas y presentaciones
                    para complementar tus rutinas de cuidado personal
                    y aromatización.
                </p>

            </div>

            <div class="row g-4">

                @foreach (var producto in doterra)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="card tarjeta-producto h-100 shadow-sm">

                            @if (!string.IsNullOrEmpty(producto.Imagen))
                            {
                                <img src="~/images/@producto.Imagen"
                                     class="card-img-top"
                                     alt="@producto.Nombre"
                                     style="height:240px; object-fit:contain; padding:20px;" />
                            }

                            <div class="card-body d-flex flex-column p-4">

                                <h5 class="fw-bold">
                                    @producto.Nombre
                                </h5>

                                @if (!string.IsNullOrEmpty(producto.Presentacion))
                                {
                                    <p class="text-muted small mb-2">
                                        Presentación: @producto.Presentacion
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(producto.Descripcion))
                                {
                                    <p>
                                        @producto.Descripcion
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(producto.Usos))
                                {
                                    <div class="mt-2">
                                        <strong>Usos:</strong>
                                        <p class="text-muted small">
                                            @producto.Usos
                                        </p>
                                    </div>
                                }

                                <div class="mt-auto">

                                    @if (producto.Precio.HasValue)
                                    {
                                        <h5 class="fw-bold text-danger mt-3">
                                            ₡@producto.Precio.Value.ToString("N0")
                                        </h5>
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            Consulte el precio.
                                        </p>
                                    }

                                    <a asp-controller="Home"
                                       asp-action="Contacto"
                                       class="btn btn-outline-danger rounded-pill px-4 w-100">
                                        Consultar producto
                                    </a>

                                </div>

                            </div>
                        </div>

                    </div>
                }

            </div>

        </section>
    }

    <hr class="my-5" />

    <!-- LEBELAGE -->
    @if (lebelage.Any())
    {
        <section class="mb-5">

            <div class="text-center mb-4">

                <img src="~/images/Productos/lebelage-imagen-principal.png"
                     alt="Productos LEBELAGE"
                     class="img-fluid rounded-4 shadow-sm mb-4"
                     style="width:100%; max-height:300px; object-fit:cover;" />

                <h2 class="fw-bold text-danger">
                    LEBELAGE
                </h2>

                <p class="text-muted mx-auto" style="max-width:750px;">
                    Descubre nuestra selección de productos cosméticos
                    para el cuidado facial, con opciones de limpieza,
                    hidratación y protección de la piel.
                </p>

            </div>

            <div class="row g-4">

                @foreach (var producto in lebelage)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="card tarjeta-producto h-100 shadow-sm">

                            @if (!string.IsNullOrEmpty(producto.Imagen))
                            {
                                <img src="~/images/@producto.Imagen"
                                     class="card-img-top"
                                     alt="@producto.Nombre"
                                     style="height:240px; object-fit:contain; padding:20px;" />
                            }

                            <div class="card-body d-flex flex-column p-4">

                                <h5 class="fw-bold">
                                    @producto.Nombre
                                </h5>

                                @if (!string.IsNullOrEmpty(producto.Presentacion))
                                {
                                    <p class="text-muted small mb-2">
                                        Presentación: @producto.Presentacion
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(producto.Descripcion))
                                {
                                    <p>
                                        @producto.Descripcion
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(producto.Usos))
                                {
                                    <div class="mt-2">
                                        <strong>Usos:</strong>
                                        <p class="text-muted small">
                                            @producto.Usos
                                        </p>
                                    </div>
                                }

                                <div class="mt-auto">

                                    @if (producto.Precio.HasValue)
                                    {
                                        <h5 class="fw-bold text-danger mt-3">
                                            ₡@producto.Precio.Value.ToString("N0")
                                        </h5>
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            Consulte el precio.
                                        </p>
                                    }

                                    <a asp-controller="Home"
                                       asp-action="Contacto"
                                       class="btn btn-outline-danger rounded-pill px-4 w-100">
                                        Consultar producto
                                    </a>

                                </div>

                            </div>
                        </div>

                    </div>
                }

            </div>

        </section>
    }

</section>
